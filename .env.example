# Vite build-time config. Use a publishable key (or the legacy anon key) only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# API runtime config. Supply secrets through the hosting environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AI_ALLOWED_USER_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional dev host for remotely hosted Express previews.
APP_URL=
